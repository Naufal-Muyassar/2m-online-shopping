{
  "name": "2m-sembako",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:all": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:reset": "pnpm --filter api db:reset",
    "db:reset:demo": "pnpm --filter api db:reset:demo",
    "demo:smoke": "pnpm --filter api demo:smoke",
    "demo:sim-pings": "pnpm --filter api demo:sim-pings",
    "demo:set-branch": "pnpm --filter api demo:set-branch",
    "local:up": "docker compose -p 2m-local --env-file infra/docker/local.env -f infra/docker/compose.dev.yml up -d",
    "local:down": "docker compose -p 2m-local --env-file infra/docker/local.env -f infra/docker/compose.dev.yml down",
    "local:reset": "pnpm --filter api db:reset:local",
    "local:api": "pnpm --filter api dev:local",
    "local:web": "pnpm -r --parallel --filter \"./apps/*\" --filter \"!api\" run dev"
  },
  "devDependencies": {
    "@2m/config": "workspace:*",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
