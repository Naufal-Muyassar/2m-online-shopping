{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/db.ts migrate",
    "db:reset": "tsx --env-file-if-exists=../../.env scripts/db.ts reset",
    "db:reset:demo": "tsx --env-file-if-exists=../../.env scripts/db.ts reset:demo"
  },
  "dependencies": {
    "@2m/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.685.0",
    "@aws-sdk/s3-request-presigner": "^3.685.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.8.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@2m/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
