# Isi sesuai kebutuhan; jangan commit .env asli
DATABASE_URL=postgres://app:app@localhost:5432/sembako
REDIS_URL=redis://localhost:6379
ML_API_URL=

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=proofs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Xendit (test keys start with xnd_development_; XENDIT_TEST_MODE must match the key; required in production)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_TEST_MODE=true
XENDIT_BASE_URL=https://api.xendit.co
CUSTOMER_WEB_URL=http://localhost:5175

# Production only (compose.prod.yml / backup scripts)
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=sembako
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_PASSPHRASE=

# customer-web (Vite)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=� OpenStreetMap contributors
