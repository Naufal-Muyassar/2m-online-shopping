# Isi sesuai kebutuhan; jangan commit .env asli
DATABASE_URL=postgres://app:app@localhost:5432/sembako
REDIS_URL=redis://localhost:6379
ML_API_URL=

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Dev values match infra/docker/compose.dev.yml (MinIO, bucket "proofs")
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=proofs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Payment provider: "mock" (default outside production; simulated payments, requires DEMO_MODE=true) or "xendit"
# (default in production). The XENDIT_* variables are required only when PAYMENT_PROVIDER=xendit.
PAYMENT_PROVIDER=mock
# Demo mode: simulated payments + admin "Tandai PAID (demo)". Default true outside production, false in production.
# Set DEMO_MODE=true to run a hosted demo with the mock provider.
DEMO_MODE=true
# Outbox worker + stock sweeper + payment reconciliation inside the API process (default true outside production or
# when DEMO_MODE=true; otherwise production runs `worker.ts` separately).
RUN_WORKER_IN_PROCESS=true
# Xendit (test keys start with xnd_development_; XENDIT_TEST_MODE must match the key)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_TEST_MODE=true
XENDIT_BASE_URL=https://api.xendit.co
CUSTOMER_WEB_URL=http://localhost:5171
# Average courier speed (km/h) for the customer tracking ETA estimate.
TRACKING_AVG_SPEED_KMH=20

# Production only (compose.prod.yml / backup scripts)
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=sembako
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_PASSPHRASE=

# customer-web (Vite)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=� OpenStreetMap contributors
