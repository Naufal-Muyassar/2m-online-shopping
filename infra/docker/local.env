# Isolated local stack: `pnpm local:up`, `pnpm local:reset`, `pnpm local:api`, `pnpm local:web`.
# Dev-only values. The root .env can point at a hosted database, so nothing here reads it.
LOCAL_PG_PORT=55432
LOCAL_REDIS_PORT=56379
LOCAL_S3_PORT=59000
LOCAL_S3_CONSOLE_PORT=59001

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://app:app@localhost:55432/sembako
DATABASE_SSL=false
REDIS_URL=redis://localhost:56379
JWT_ACCESS_SECRET=local-docker-only-not-a-real-secret
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=proofs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PAYMENT_PROVIDER=mock
DEMO_MODE=true
RUN_WORKER_IN_PROCESS=true
CUSTOMER_WEB_URL=http://localhost:5171
